{
  "name": "@hazzajenko/outlook-mail-mcp",
  "version": "0.1.1",
  "description": "Query personal Outlook via Microsoft Graph. CLI + MCP server for Claude.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hazzajenko/outlook-mail-mcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.9",
  "bin": {
    "outlook-mail": "./dist/cli.js",
    "outlook-mail-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev:cli": "tsx src/cli.ts",
    "dev:mcp": "tsx src/mcp.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "fix": "biome check --write src tests",
    "check": "biome check --write src tests && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@azure/msal-node": "^3.8.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "msw": "^2.8.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
